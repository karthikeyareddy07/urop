{
  "python.defaultInterpreterPath": "${workspaceFolder}/tools/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.extraPaths": [
    "./TG-ReDial-main",
    "./tools"
  ],
  "git.autofetch": true,
  "gitdoc.enabled": true,
  "gitdoc.autoPush": "afterDelay",
  "gitdoc.delay": 300000,
  "gitdoc.commitMessageFormat": "chore: auto-save ${timestamp}",
  "gitdoc.pullOnOpen": false
}
