// markdownlint configuration — honored by the VS Code markdownlint extension
// (David Anson, >= 0.12) and by the markdownlint-cli2 CLI, including the
// per-glob overrides below.
{
  "config": {
    "default": true,
    // MD013 (80-char lines) is off: this repo intentionally contains long
    // LaTeX result tables, CLI examples, and audit-checklist lines.
    "MD013": false
  },
  "globs": [
    {
      // LaTeX (IEEEtran) sources stored with a .md extension for
      // diff-friendliness: their first line is \documentclass, so the
      // "first line must be a top-level heading" rule cannot apply.
      "globs": [
        "tools/paper/paper.md",
        "**/tools/paper/paper.md",
        "tools/paper.md",
        "**/tools/paper.md"
      ],
      "config": {
        "MD041": false
      }
    }
  ]
}
